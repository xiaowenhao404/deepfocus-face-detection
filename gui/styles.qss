/* 
 * DeepFocus 样式表
 * 现代简洁风格，灵感来自iOS设计规范
 */

/* ==================== 主窗口 ==================== */
QMainWindow {
    background-color: #ffffff;
}

/* ==================== 按钮样式 ==================== */
QPushButton {
    background-color: #007aff;
    color: white;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0051d5;
}

QPushButton:pressed {
    background-color: #003d99;
}

QPushButton:disabled {
    background-color: #e5e5e5;
    color: #a1a1a1;
}

/* ==================== 分组框 ==================== */
QGroupBox {
    font-weight: bold;
    font-size: 13px;
    border: 2px solid #e5e5e5;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 12px;
    background-color: #fafafa;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 15px;
    padding: 0 8px;
    background-color: #fafafa;
}

/* ==================== 文本编辑框 ==================== */
QTextEdit {
    border: 1px solid #d1d1d6;
    border-radius: 8px;
    background-color: #f9f9f9;
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 12px;
    padding: 8px;
    color: #1d1d1f;
}

QTextEdit:focus {
    border: 2px solid #007aff;
    background-color: #ffffff;
}

/* ==================== 标签 ==================== */
QLabel {
    color: #1d1d1f;
}

/* 标题标签 */
QLabel[class="title"] {
    font-size: 16px;
    font-weight: bold;
    color: #1d1d1f;
}

/* ==================== 状态栏 ==================== */
QStatusBar {
    background-color: #f5f5f7;
    color: #1d1d1f;
    border-top: 1px solid #d1d1d6;
    font-size: 12px;
    padding: 4px;
}

QStatusBar::item {
    border: none;
}

/* ==================== 分隔器 ==================== */
QSplitter::handle {
    background-color: #e5e5e5;
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #007aff;
}

/* ==================== 文件对话框按钮优化 ==================== */
QFileDialog QPushButton {
    min-width: 80px;
    min-height: 28px;
    padding: 6px 16px;
}

/* ==================== 滚动条（现代风格） ==================== */
QScrollBar:vertical {
    border: none;
    background-color: #f5f5f7;
    width: 10px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #c7c7cc;
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background-color: #aeaeb2;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* 水平滚动条 */
QScrollBar:horizontal {
    border: none;
    background-color: #f5f5f7;
    height: 10px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #c7c7cc;
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #aeaeb2;
}

/* ==================== 工具提示 ==================== */
QToolTip {
    background-color: #1d1d1f;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ==================== 消息框 ==================== */
QMessageBox {
    background-color: #ffffff;
}

QMessageBox QLabel {
    color: #1d1d1f;
    font-size: 13px;
}

QMessageBox QPushButton {
    min-width: 80px;
    min-height: 32px;
}

